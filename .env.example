# Client-side (Expo public)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# See lib/quickpose.ts: must be EXPO_PUBLIC_-prefixed to reach the client,
# unlike the server-only vars below.
EXPO_PUBLIC_QUICKPOSE_SDK_KEY=
# See lib/googleAuth.ts — the WEB client ID from Google Cloud Console (not
# the Android one), also entered as-is in Supabase's Google provider config.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-side only (Edge Functions)
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
